# Local dev default is SQLite (zero config). For production, point this at
# Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg://intellex:intellex@localhost:5432/intellex
DATABASE_URL=sqlite:///./intellex.db

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# How often the background ingestion cycle re-collects every feed, in minutes.
REFRESH_INTERVAL_MINUTES=15

RUN_INGESTION_ON_STARTUP=true

EVENT_KEYWORD_OVERLAP_THRESHOLD=3

# AI Workspace (optional). Get a free key at https://openrouter.ai/keys --
# the default model below has a $0 tier, no credit card required. Leave
# blank to run without AI Workspace; the rest of the app is unaffected.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
