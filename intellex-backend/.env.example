# Copy this file to backend/.env for local dev, or provide these as real
# environment variables in your deployment platform (Railway/Render/Fly/
# Docker Compose). Never commit an actual .env file.

# --- Database ---
# Local dev default (no config needed) is SQLite:
#   DATABASE_URL=sqlite:///./intellex.db
# Production: point at Postgres. docker-compose.yml already wires this
# to the bundled postgres service automatically -- only set this
# yourself if you're deploying against an external/managed Postgres
# instance instead.
DATABASE_URL=postgresql+psycopg://intellex:intellex@postgres:5432/intellex

# --- CORS ---
# Comma-separated list of origins allowed to call this API. Must
# include your deployed frontend's actual URL in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Auth ---
# REQUIRED in any non-local deployment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app runs with an insecure dev-only fallback if this is unset, so
# it still works with zero config locally -- but anyone who knows that
# fallback value can forge valid session tokens, so this must be set to
# a real random secret before this is exposed outside localhost.
JWT_SECRET=

# --- AI Workspace (optional) ---
# Leave empty to run without AI Workspace enabled.
OPENROUTER_API_KEY=

# --- Ingestion ---
REFRESH_INTERVAL_MINUTES=15
RUN_INGESTION_ON_STARTUP=true

# --- Postgres (used by docker-compose.yml's postgres service itself,
# not read by the backend directly -- kept here so one .env file
# configures the whole stack) ---
POSTGRES_USER=intellex
POSTGRES_PASSWORD=intellex
POSTGRES_DB=intellex
